<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Health Connect Permissions -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <!--
        Total calories already includes basal + active energy, so it is deliberately kept out of
        the app's own RMR + NEAT + exercise + TEF model and used only as a "your watch says X, our
        model says Y" cross-check. See DailyActivityLog.
    -->
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <!-- Overnight HRV. Previously the only source was manual entry, so it was nearly always absent. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SPEED" />
    <uses-permission android:name="android.permission.health.READ_POWER" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_BONE_MASS" />
    <uses-permission android:name="android.permission.health.READ_LEAN_BODY_MASS" />

    <application
        android:name=".TriPathApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TriPath"
        tools:targetApi="34">

        <!-- Main Activity (placeholder - to be implemented) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TriPath">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Health Connect Privacy Policy Activity -->
        <!-- Required for Health Connect integration -->
        <activity
            android:name=".HealthConnectPrivacyPolicyActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Health Connect Permission Declaration -->
        <!-- This tells Health Connect which permissions this app uses -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".HealthConnectPrivacyPolicyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Nutrition home-screen widget (Jetpack Glance) -->
        <receiver
            android:name=".widget.NutritionWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nutrition_widget_info" />
        </receiver>

        <!--
            Read-only bridge that lets LiftPath consume TriPath's training load, recovery and
            energy figures. Deliberately carries no android:permission: the two apps are signed
            with different keys, so a signature permission would always be denied. The provider
            verifies callingPackage instead, which the framework derives from the binder UID and
            an app therefore cannot forge. See TriPathShareProvider.assertCallerAllowed.
        -->
        <provider
            android:name=".data.local.share.TriPathShareProvider"
            android:authorities="com.tripath.share"
            android:exported="true" />

    </application>

    <!-- Declare that this app uses Health Connect -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.liftpath" />
    </queries>

</manifest>

